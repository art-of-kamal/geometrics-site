---
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — GeoMetrics</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232563eb'/%3E%3Ctext x='50%25' y='54%25' dominant-baseline='middle' text-anchor='middle' fill='%23ffffff' font-family='-apple-system, sans-serif' font-size='18' font-weight='700'%3EG%3C/text%3E%3C/svg%3E"
    />
    <style>
      :root {
        --bg: #ffffff;
        --surface: #f8fafc;
        --border: #e2e8f0;
        --text: #0f172a;
        --muted: #475569;
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
        --accent-soft: #eff6ff;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.7;
      }
      a { color: inherit; text-decoration: none; }
      .container { max-width: 740px; margin: 0 auto; padding: 0 24px; }

      header { border-bottom: 1px solid var(--border); background: #fff; }
      .nav {
        max-width: 860px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 68px;
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.12rem;
        font-weight: 700;
      }
      .logo-mark {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: var(--accent);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        font-weight: 800;
      }
      .nav-right { display: flex; gap: 20px; align-items: center; font-size: 0.9rem; }
      .btn-nav {
        background: var(--text);
        color: #fff;
        padding: 8px 15px;
        border-radius: 8px;
        font-weight: 600;
      }

      article { padding: 48px 0 56px; }
      .back-link {
        display: inline-block;
        font-size: 0.88rem;
        color: var(--accent);
        font-weight: 600;
        margin-bottom: 20px;
      }
      .post-date { font-size: 0.85rem; color: var(--muted); margin-bottom: 10px; }
      h1 {
        font-size: clamp(1.85rem, 4vw, 2.45rem);
        line-height: 1.18;
        letter-spacing: -0.03em;
        margin-bottom: 14px;
      }
      .lead {
        font-size: 1.08rem;
        color: var(--muted);
        padding-bottom: 28px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 32px;
      }

      .prose :global(h2) {
        font-size: 1.4rem;
        letter-spacing: -0.02em;
        margin: 32px 0 12px;
      }
      .prose :global(h3) {
        font-size: 1.12rem;
        margin: 24px 0 10px;
      }
      .prose :global(p) {
        margin-bottom: 18px;
        color: #1e293b;
      }
      .prose :global(ul), .prose :global(ol) {
        margin: 0 0 18px 22px;
        color: #1e293b;
      }
      .prose :global(li) { margin-bottom: 8px; }
      .prose :global(strong) { color: var(--text); }

      /* Embedded Waitlist Box */
      .cta-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 32px;
        margin-bottom: 64px;
      }
      .cta-box h2 {
        font-size: 1.3rem;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
      }
      .cta-box > p {
        font-size: 0.94rem;
        color: var(--muted);
        margin-bottom: 20px;
      }
      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }
      .field { display: flex; flex-direction: column; }
      .field.full { grid-column: 1 / -1; }
      label { font-size: 0.8rem; font-weight: 600; margin-bottom: 5px; }
      input {
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 0.92rem;
        background: #fff;
      }
      input:focus { outline: none; border-color: var(--accent); }
      button {
        margin-top: 6px;
        padding: 12px 20px;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.94rem;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { background: var(--accent-hover); }
      button:disabled { opacity: 0.65; cursor: not-allowed; }
      .status-box {
        display: none;
        background: var(--accent-soft);
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 18px;
        text-align: center;
      }
      .error-msg {
        display: none;
        color: #dc2626;
        font-size: 0.84rem;
        grid-column: 1 / -1;
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 28px 0;
        font-size: 0.86rem;
        color: var(--muted);
        display: flex;
        justify-content: space-between;
      }
      @media (max-width: 600px) {
        .form-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="nav">
        <a href="/" class="logo">
          <span class="logo-mark">G</span>
          GeoMetrics
        </a>
        <div class="nav-right">
          <a href="/blog">All Posts</a>
          <a href="#blog-waitlist" class="btn-nav">Check Your Brand</a>
        </div>
      </div>
    </header>

    <main class="container">
      <article>
        <a href="/blog" class="back-link">← Back to Blog</a>
        <div class="post-date">
          {pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </div>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="prose">
          <slot />
        </div>
      </article>

      <!-- Auto-embedded Formspree Waitlist Form -->
      <section class="cta-box" id="blog-waitlist">
        <h2>Want to see where your brand stands in AI search?</h2>
        <p>
          Leave your brand and product details below. We'll add you to the
          waitlist and get back to you.
        </p>

        <form
          id="blog-form"
          class="form-grid"
          action="https://formspree.io/f/xyewbbne"
          method="POST"
        >
          <div class="field">
            <label for="brand">Brand / Website</label>
            <input type="text" id="brand" name="brand" placeholder="yourbrand.com" required />
          </div>
          <div class="field">
            <label for="product">Product / Category</label>
            <input type="text" id="product" name="product" placeholder="e.g. CRM Software" required />
          </div>
          <div class="field">
            <label for="email">Work Email</label>
            <input type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>
          <div class="field">
            <label for="phone">Phone / WhatsApp (Optional)</label>
            <input type="tel" id="phone" name="phone" placeholder="+91 ..." />
          </div>
          <div class="field full">
            <button type="submit" id="blog-submit-btn">Join Waitlist</button>
          </div>
          <p class="error-msg" id="blog-error">Something went wrong. Please try again.</p>
        </form>

        <div class="status-box" id="blog-status">
          <strong>You're on the waitlist.</strong>
          <p>We've received your details and will get back to you soon.</p>
        </div>
      </section>
    </main>

    <footer class="container">
      <span>© 2026 GeoMetrics</span>
      <a href="/blog">Blog</a>
    </footer>

    <script>
      const form = document.getElementById('blog-form');
      const btn = document.getElementById('blog-submit-btn');
      const statusBox = document.getElementById('blog-status');
      const errorMsg = document.getElementById('blog-error');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Submitting...';
        errorMsg.style.display = 'none';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (response.ok) {
            form.reset();
            form.style.display = 'none';
            statusBox.style.display = 'block';
          } else {
            throw new Error('Failed');
          }
        } catch {
          errorMsg.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Join Waitlist';
        }
      });
    </script>
  </body>
</html>
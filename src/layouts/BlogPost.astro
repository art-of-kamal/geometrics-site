---
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — GeoMetrics</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23111827'/%3E%3Ctext x='50%25' y='54%25' dominant-baseline='middle' text-anchor='middle' fill='%23ffffff' font-family='-apple-system, sans-serif' font-size='18' font-weight='700'%3EG%3C/text%3E%3C/svg%3E"
    />
    <style>
      :root {
        --bg: #ffffff;
        --subtle: #fafafa;
        --border: #e5e7eb;
        --border-light: #f3f4f6;
        --text: #111827;
        --muted: #6b7280;
        --dark: #111827;
        --dark-hover: #1f2937;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .container { max-width: 720px; margin: 0 auto; padding: 0 24px; }

      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border-light);
      }
      .nav {
        max-width: 1020px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 64px;
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .logo-mark {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: var(--dark);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
      }
      .nav-actions { display: flex; align-items: center; gap: 10px; }
      .btn-outline {
        padding: 7px 14px;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 0.84rem;
        font-weight: 500;
      }
      .btn-outline:hover { background: var(--subtle); }
      .btn-dark {
        padding: 7px 15px;
        border-radius: 7px;
        font-size: 0.84rem;
        font-weight: 600;
        color: #fff;
        background: var(--dark);
      }
      .btn-dark:hover { background: var(--dark-hover); }

      article { padding: 52px 0 48px; }
      .back-link {
        display: inline-block;
        font-size: 0.85rem;
        color: var(--muted);
        margin-bottom: 24px;
      }
      .back-link:hover { color: var(--text); }
      .post-date { font-size: 0.84rem; color: var(--muted); margin-bottom: 10px; }
      h1 {
        font-size: clamp(1.85rem, 4vw, 2.45rem);
        line-height: 1.18;
        letter-spacing: -0.03em;
        margin-bottom: 14px;
      }
      .lead {
        font-size: 1.05rem;
        color: var(--muted);
        padding-bottom: 28px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 32px;
      }

      .prose :global(h2) {
        font-size: 1.35rem;
        letter-spacing: -0.02em;
        margin: 32px 0 12px;
      }
      .prose :global(h3) {
        font-size: 1.1rem;
        margin: 24px 0 10px;
      }
      .prose :global(p) {
        margin-bottom: 18px;
        color: #1f2937;
      }
      .prose :global(ul), .prose :global(ol) {
        margin: 0 0 18px 22px;
        color: #1f2937;
      }
      .prose :global(li) { margin-bottom: 8px; }
      .prose :global(strong) { color: var(--text); }

      /* Monochrome Waitlist Box */
      .cta-box {
        background: var(--subtle);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 28px;
        margin: 16px 0 64px;
      }
      .cta-box h2 {
        font-size: 1.25rem;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
      }
      .cta-box > p {
        font-size: 0.9rem;
        color: var(--muted);
        margin-bottom: 20px;
      }
      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }
      input {
        width: 100%;
        padding: 10px 13px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 0.9rem;
        background: #fff;
        color: var(--text);
      }
      input:focus { outline: none; border-color: var(--dark); }
      .full { grid-column: 1 / -1; }
      button {
        width: 100%;
        margin-top: 4px;
        padding: 11px 20px;
        background: var(--dark);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
      }
      button:hover { background: var(--dark-hover); }
      button:disabled { opacity: 0.6; cursor: not-allowed; }
      .status-box {
        display: none;
        text-align: center;
        padding: 16px 8px;
      }
      .status-box strong { display: block; margin-bottom: 4px; }
      .status-box p { font-size: 0.88rem; color: var(--muted); }
      .error-msg {
        display: none;
        color: #dc2626;
        font-size: 0.82rem;
        grid-column: 1 / -1;
      }

      footer {
        border-top: 1px solid var(--border-light);
        padding: 28px 0;
        font-size: 0.84rem;
        color: var(--muted);
        display: flex;
        justify-content: space-between;
      }
      @media (max-width: 600px) {
        .form-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="nav">
        <a href="/" class="logo">
          <span class="logo-mark">G</span>
          GeoMetrics
        </a>
        <div class="nav-actions">
          <a href="/blog" class="btn-outline">All Posts</a>
          <a href="#blog-waitlist" class="btn-dark">Check Your Brand</a>
        </div>
      </div>
    </header>

    <main class="container">
      <article>
        <a href="/blog" class="back-link">← Back to Blog</a>
        <div class="post-date">
          {pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </div>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="prose">
          <slot />
        </div>
      </article>

      <!-- Auto-embedded Monochrome Formspree Waitlist -->
      <section class="cta-box" id="blog-waitlist">
        <h2>Want to see where your brand stands in AI search?</h2>
        <p>
          Leave your details below. We'll add you to the waitlist and get back
          to you.
        </p>

        <form
          id="blog-form"
          class="form-grid"
          action="https://formspree.io/f/xyewbbne"
          method="POST"
        >
          <input type="text" name="brand" placeholder="Brand or website (yourbrand.com)" required />
          <input type="text" name="product" placeholder="Product / category (e.g. CRM Software)" required />
          <input type="email" name="email" placeholder="Work email (you@company.com)" required />
          <input type="tel" name="phone" placeholder="Phone / WhatsApp (Optional)" />
          <div class="full">
            <button type="submit" id="blog-submit-btn">Join Waitlist →</button>
          </div>
          <p class="error-msg" id="blog-error">Something went wrong. Please try again.</p>
        </form>

        <div class="status-box" id="blog-status">
          <strong>You're on the waitlist.</strong>
          <p>We've received your details and will get back to you soon.</p>
        </div>
      </section>
    </main>

    <footer class="container">
      <span>© 2026 GeoMetrics</span>
      <a href="/blog">Blog</a>
    </footer>

    <script>
      const form = document.getElementById('blog-form');
      const btn = document.getElementById('blog-submit-btn');
      const statusBox = document.getElementById('blog-status');
      const errorMsg = document.getElementById('blog-error');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Submitting...';
        errorMsg.style.display = 'none';

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (response.ok) {
            form.reset();
            form.style.display = 'none';
            statusBox.style.display = 'block';
          } else {
            throw new Error('Failed');
          }
        } catch {
          errorMsg.style.display = 'block';
          btn.disabled = false;
          btn.textContent = 'Join Waitlist →';
        }
      });
    </script>
  </body>
</html>
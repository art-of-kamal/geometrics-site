---
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog — {SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23111827'/%3E%3Ctext x='50%25' y='54%25' dominant-baseline='middle' text-anchor='middle' fill='%23ffffff' font-family='-apple-system, sans-serif' font-size='18' font-weight='700'%3EG%3C/text%3E%3C/svg%3E"
    />
    <style>
      :root {
        --bg: #ffffff;
        --subtle: #fafafa;
        --border: #e5e7eb;
        --border-light: #f3f4f6;
        --text: #111827;
        --muted: #6b7280;
        --dark: #111827;
        --dark-hover: #1f2937;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; text-decoration: none; }
      .container { max-width: 1020px; margin: 0 auto; padding: 0 24px; }

      /* Navbar (Matches Homepage) */
      header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border-light);
      }
      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 64px;
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .logo-mark {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: var(--dark);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
      }
      .nav-actions { display: flex; align-items: center; gap: 10px; }
      .btn-outline {
        padding: 7px 14px;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 0.84rem;
        font-weight: 500;
      }
      .btn-outline:hover { background: var(--subtle); }
      .btn-dark {
        padding: 7px 15px;
        border-radius: 7px;
        font-size: 0.84rem;
        font-weight: 600;
        color: #fff;
        background: var(--dark);
      }
      .btn-dark:hover { background: var(--dark-hover); }

      /* Blog Header */
      .blog-head {
        padding: 64px 0 40px;
        text-align: center;
        max-width: 640px;
        margin: 0 auto;
      }
      .blog-head h1 {
        font-size: clamp(2rem, 4vw, 2.6rem);
        font-weight: 700;
        letter-spacing: -0.035em;
        margin-bottom: 12px;
      }
      .blog-head p {
        color: var(--muted);
        font-size: 1rem;
      }

      /* Post Grid */
      .post-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        padding: 16px 0 80px;
      }
      .post-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 26px;
        transition: border-color 0.15s ease;
      }
      .post-card:hover { border-color: #9ca3af; }
      .post-date {
        font-size: 0.8rem;
        color: var(--muted);
        margin-bottom: 10px;
      }
      .post-card h2 {
        font-size: 1.2rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.3;
        margin-bottom: 10px;
      }
      .post-card p {
        font-size: 0.9rem;
        color: var(--muted);
        margin-bottom: 18px;
      }
      .read-more {
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--text);
      }

      footer {
        border-top: 1px solid var(--border-light);
        padding: 28px 0;
        font-size: 0.84rem;
        color: var(--muted);
        display: flex;
        justify-content: space-between;
      }

      @media (max-width: 720px) {
        .post-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav">
        <a href="/" class="logo">
          <span class="logo-mark">G</span>
          GeoMetrics
        </a>
        <div class="nav-actions">
          <a href="/" class="btn-outline">Home</a>
          <a href="/#request" class="btn-dark">Check Your Brand</a>
        </div>
      </div>
    </header>

    <main class="container">
      <div class="blog-head">
        <h1>AI Search &amp; GEO Insights</h1>
        <p>
          Research, benchmarks, and notes on how ChatGPT, Perplexity, Claude,
          and Google AI Overviews decide which brands to recommend.
        </p>
      </div>

      <div class="post-grid">
        {posts.map((post) => {
          const slug = post.slug ?? post.id.replace(/\.mdx?$/, '');
          return (
            <a href={`/blog/${slug}/`} class="post-card">
              <div>
                <div class="post-date">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <span class="read-more">Read article →</span>
            </a>
          );
        })}
      </div>
    </main>

    <footer class="container">
      <span>© 2026 GeoMetrics</span>
      <a href="/">Home</a>
    </footer>
  </body>
</html>
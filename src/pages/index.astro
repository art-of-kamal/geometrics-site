---
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog — {SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232563eb'/%3E%3Ctext x='50%25' y='54%25' dominant-baseline='middle' text-anchor='middle' fill='%23ffffff' font-family='-apple-system, sans-serif' font-size='18' font-weight='700'%3EG%3C/text%3E%3C/svg%3E"
    />
    <style>
      :root {
        --bg: #ffffff;
        --surface: #f8fafc;
        --border: #e2e8f0;
        --text: #0f172a;
        --muted: #475569;
        --accent: #2563eb;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }
      a { color: inherit; text-decoration: none; }
      .container { max-width: 860px; margin: 0 auto; padding: 0 24px; }

      header {
        border-bottom: 1px solid var(--border);
        background: #fff;
      }
      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 68px;
      }
      .logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 1.12rem;
        font-weight: 700;
      }
      .logo-mark {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: var(--accent);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        font-weight: 800;
      }
      .btn-nav {
        background: var(--text);
        color: #fff;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 600;
      }

      .blog-head {
        padding: 56px 0 36px;
        border-bottom: 1px solid var(--border);
      }
      .eyebrow {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--accent);
        margin-bottom: 8px;
      }
      h1 {
        font-size: clamp(1.9rem, 4vw, 2.5rem);
        letter-spacing: -0.03em;
        margin-bottom: 10px;
      }
      .blog-head p { color: var(--muted); max-width: 580px; }

      .post-list {
        padding: 36px 0 72px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .post-card {
        display: block;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 26px;
        transition: border-color 0.15s ease;
      }
      .post-card:hover { border-color: var(--accent); }
      .post-date {
        font-size: 0.82rem;
        color: var(--muted);
        margin-bottom: 6px;
      }
      .post-card h2 {
        font-size: 1.3rem;
        letter-spacing: -0.02em;
        margin-bottom: 8px;
      }
      .post-card p {
        font-size: 0.95rem;
        color: var(--muted);
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 28px 0;
        font-size: 0.86rem;
        color: var(--muted);
        display: flex;
        justify-content: space-between;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav">
        <a href="/" class="logo">
          <span class="logo-mark">G</span>
          GeoMetrics
        </a>
        <a href="/#request" class="btn-nav">Check Your Brand</a>
      </div>
    </header>

    <main class="container">
      <div class="blog-head">
        <div class="eyebrow">GeoMetrics Research</div>
        <h1>AI Search & GEO Insights</h1>
        <p>
          Notes, benchmarks, and research on how ChatGPT, Perplexity, Claude,
          and Google AI Overviews decide which brands to recommend.
        </p>
      </div>

      <div class="post-list">
        {posts.map((post) => {
          const slug = post.slug ?? post.id.replace(/\.mdx?$/, '');
          return (
            <a href={`/blog/${slug}/`} class="post-card">
              <div class="post-date">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          );
        })}
      </div>
    </main>

    <footer class="container">
      <span>© 2026 GeoMetrics</span>
      <a href="/">Home</a>
    </footer>
  </body>
</html>
---
// src/pages/index.astro
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GeoMetrics — AI Search Visibility Benchmarks</title>
    <meta
      name="description"
      content="Independent GEO and AI search visibility benchmarks. See where your brand stands across ChatGPT, Perplexity, Gemini, and AI Overviews."
    />
    <!-- Minimal Geometric 'G' Tab Icon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23111111'/%3E%3Ctext x='50%25' y='54%25' dominant-baseline='middle' text-anchor='middle' fill='%23ffffff' font-family='-apple-system, sans-serif' font-size='18' font-weight='700'%3EG%3C/text%3E%3C/svg%3E"
    />
    <style>
      :root {
        --bg: #ffffff;
        --surface: #f5f5f7;
        --border: #e5e5ea;
        --text: #111111;
        --muted: #6e6e73;
        --btn: #111111;
        --btn-hover: #333333;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI",
          Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        max-width: 780px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Navigation */
      header {
        padding: 24px 0;
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .nav-link {
        font-size: 0.92rem;
        color: var(--muted);
        transition: color 0.15s ease;
      }

      .nav-link:hover {
        color: var(--text);
      }

      /* Hero */
      .hero {
        padding: 72px 0 48px;
      }

      h1 {
        font-size: clamp(2.1rem, 5vw, 3.1rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.035em;
        margin-bottom: 20px;
      }

      .hero p {
        font-size: 1.15rem;
        color: var(--muted);
        max-width: 580px;
      }

      /* Sample Snapshot Preview */
      .preview-wrap {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 28px;
        margin: 16px 0 64px;
      }

      .preview-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        font-size: 0.82rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
      }

      .preview-metrics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        padding-bottom: 22px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 18px;
      }

      .metric-num {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.03em;
      }

      .metric-label {
        font-size: 0.82rem;
        color: var(--muted);
        margin-top: 2px;
      }

      .engine-rows {
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 0.9rem;
      }

      .engine-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .engine-name {
        font-weight: 500;
      }

      .engine-stat {
        color: var(--muted);
      }

      /* Form Section */
      .form-section {
        padding-bottom: 84px;
      }

      .form-section h2 {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        margin-bottom: 8px;
      }

      .form-sub {
        color: var(--muted);
        font-size: 0.98rem;
        margin-bottom: 28px;
      }

      form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      .field {
        display: flex;
        flex-direction: column;
      }

      .field.full {
        grid-column: 1 / -1;
      }

      label {
        font-size: 0.84rem;
        font-weight: 600;
        margin-bottom: 6px;
        color: var(--text);
      }

      input {
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 10px;
        font-size: 0.95rem;
        background: var(--bg);
        color: var(--text);
        transition: border-color 0.15s ease;
      }

      input:focus {
        outline: none;
        border-color: var(--text);
      }

      button {
        margin-top: 8px;
        padding: 14px 24px;
        background: var(--btn);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-size: 0.96rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease;
      }

      button:hover {
        background: var(--btn-hover);
      }

      button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }

      .status-box {
        display: none;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 24px;
        font-size: 0.98rem;
      }

      .status-box strong {
        display: block;
        margin-bottom: 4px;
      }

      .error-msg {
        display: none;
        color: #d93025;
        font-size: 0.88rem;
        grid-column: 1 / -1;
      }

      /* Footer */
      footer {
        border-top: 1px solid var(--border);
        padding: 28px 0;
        font-size: 0.85rem;
        color: var(--muted);
        display: flex;
        justify-content: space-between;
      }

      @media (max-width: 600px) {
        .preview-metrics {
          grid-template-columns: 1fr;
        }
        form {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container nav">
        <a href="/" class="logo">GeoMetrics</a>
        <a href="/blog" class="nav-link">Blog</a>
      </div>
    </header>

    <main class="container">
      <!-- Concise Story -->
      <section class="hero">
        <h1>See where your brand stands in AI search.</h1>
        <p>
          Buyers are asking ChatGPT, Perplexity, and Gemini what to choose.
          GeoMetrics measures how often your brand is cited, how it's ranked,
          and which sources drive those answers—pure visibility data, no agency
          pitch.
        </p>
      </section>

      <!-- Visual Proof: Minimal Sample Snapshot -->
      <section class="preview-wrap" aria-label="Sample Brand Benchmark">
        <div class="preview-header">
          <span>Sample Snapshot · Acme Cloud</span>
          <span>Monthly Benchmark</span>
        </div>

        <div class="preview-metrics">
          <div>
            <div class="metric-num">34.2%</div>
            <div class="metric-label">AI Citation Share</div>
          </div>
          <div>
            <div class="metric-num">#2</div>
            <div class="metric-label">Avg. Answer Position</div>
          </div>
          <div>
            <div class="metric-num">18</div>
            <div class="metric-label">Cited Third-Party Sources</div>
          </div>
        </div>

        <div class="engine-rows">
          <div class="engine-row">
            <span class="engine-name">ChatGPT</span>
            <span class="engine-stat">Cited in 41% of category prompts · Rank #2</span>
          </div>
          <div class="engine-row">
            <span class="engine-name">Perplexity</span>
            <span class="engine-stat">Cited in 36% of category prompts · Rank #1</span>
          </div>
          <div class="engine-row">
            <span class="engine-name">Google AI Overviews / Gemini</span>
            <span class="engine-stat">Cited in 25% of category prompts · Rank #3</span>
          </div>
        </div>
      </section>

      <!-- Waitlist / Request Form -->
      <section class="form-section" id="request">
        <h2>Check your brand's position</h2>
        <p class="form-sub">
          Share your details below. We'll add you to the list and get back to
          you.
        </p>

        <form
          id="waitlist-form"
          action="https://formspree.io/f/xyewbbne"
          method="POST"
        >
          <div class="field">
            <label for="brand">Brand / Website</label>
            <input
              type="text"
              id="brand"
              name="brand"
              placeholder="e.g. yourbrand.com"
              required
            />
          </div>

          <div class="field">
            <label for="product">Product / Category</label>
            <input
              type="text"
              id="product"
              name="product"
              placeholder="e.g. CRM Software, Running Shoes"
              required
            />
          </div>

          <div class="field">
            <label for="email">Work Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="you@company.com"
              required
            />
          </div>

          <div class="field">
            <label for="phone">Phone / WhatsApp (Optional)</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+91 ..."
            />
          </div>

          <div class="field full">
            <button type="submit" id="submit-btn">Join Waitlist</button>
          </div>

          <p class="error-msg" id="error-msg">
            Something went wrong. Please try again.
          </p>
        </form>

        <div class="status-box" id="status-box">
          <strong>You're on the waitlist.</strong>
          We've received your details and will get back to you soon.
        </div>
      </section>
    </main>

    <footer class="container">
      <span>© 2026 GeoMetrics</span>
      <a href="/blog">Blog</a>
    </footer>

    <script>
      const form = document.getElementById("waitlist-form");
      const btn = document.getElementById("submit-btn");
      const statusBox = document.getElementById("status-box");
      const errorMsg = document.getElementById("error-msg");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = "Submitting...";
        errorMsg.style.display = "none";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });

          if (response.ok) {
            form.reset();
            form.style.display = "none";
            statusBox.style.display = "block";
          } else {
            throw new Error("Submission failed");
          }
        } catch {
          errorMsg.style.display = "block";
          btn.disabled = false;
          btn.textContent = "Join Waitlist";
        }
      });
    </script>
  </body>
</html>
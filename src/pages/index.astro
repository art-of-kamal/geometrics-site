---
// src/pages/index.astro
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GeoMetrics — AI Search & GEO Visibility Benchmarks</title>
    <meta
      name="description"
      content="Independent GEO, AEO, and AI search visibility benchmarks for brands. See exactly where you stand across LLMs."
    />
    <style>
      :root {
        --bg: #ffffff;
        --surface: #f8fafc;
        --border: #e2e8f0;
        --text: #0f172a;
        --muted: #475569;
        --accent: #2563eb;
        --accent-hover: #1d4ed8;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        max-width: 980px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Header */
      header {
        border-bottom: 1px solid var(--border);
        padding: 18px 0;
        position: sticky;
        top: 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(6px);
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        font-size: 1.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        gap: 24px;
        align-items: center;
        font-size: 0.95rem;
        color: var(--muted);
      }

      .nav-links a:hover {
        color: var(--text);
      }

      .btn-sm {
        background: var(--text);
        color: #fff !important;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 500;
      }

      /* Hero */
      .hero {
        padding: 84px 0 64px;
        max-width: 720px;
      }

      .badge {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--accent);
        background: #eff6ff;
        padding: 4px 12px;
        border-radius: 999px;
        margin-bottom: 18px;
      }

      h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin-bottom: 18px;
      }

      .hero p {
        font-size: 1.12rem;
        color: var(--muted);
        margin-bottom: 28px;
      }

      .btn-primary {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        padding: 13px 24px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.98rem;
        border: none;
        cursor: pointer;
      }

      .btn-primary:hover {
        background: var(--accent-hover);
      }

      /* Sections */
      section {
        padding: 56px 0;
        border-top: 1px solid var(--border);
      }

      h2 {
        font-size: 1.55rem;
        letter-spacing: -0.02em;
        margin-bottom: 10px;
      }

      .section-sub {
        color: var(--muted);
        margin-bottom: 32px;
        max-width: 640px;
      }

      /* KPI Sample Grid */
      .grid-3 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 24px;
      }

      .kpi-label {
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        font-weight: 600;
      }

      .kpi-value {
        font-size: 2rem;
        font-weight: 700;
        margin: 8px 0 10px;
        color: var(--text);
      }

      .card p {
        font-size: 0.93rem;
        color: var(--muted);
      }

      /* Steps */
      .step-num {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--accent);
        margin-bottom: 6px;
      }

      .card h3 {
        font-size: 1.08rem;
        margin-bottom: 8px;
      }

      /* Form Section */
      .form-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 36px;
        max-width: 580px;
      }

      .form-group {
        margin-bottom: 16px;
      }

      label {
        display: block;
        font-size: 0.88rem;
        font-weight: 600;
        margin-bottom: 6px;
      }

      input {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid var(--border);
        border-radius: 7px;
        font-size: 0.96rem;
        background: #fff;
        color: var(--text);
      }

      input:focus {
        outline: 2px solid var(--accent);
        border-color: transparent;
      }

      .form-note {
        font-size: 0.82rem;
        color: var(--muted);
        margin-top: 12px;
      }

      /* Footer */
      footer {
        border-top: 1px solid var(--border);
        padding: 32px 0;
        color: var(--muted);
        font-size: 0.88rem;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
      }

      .footer-links {
        display: flex;
        gap: 20px;
      }

      .footer-links a:hover {
        color: var(--text);
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container nav">
        <a href="/" class="logo">GeoMetrics</a>
        <nav class="nav-links">
          <a href="#metrics">What We Measure</a>
          <a href="/blog">Blog</a>
          <a href="#request" class="btn-sm">Get Sample Report</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <!-- Hero -->
      <div class="hero">
        <span class="badge">GEO · AEO · AI Search Intelligence</span>
        <h1>Know exactly where your brand stands in AI search.</h1>
        <p>
          GeoMetrics delivers clear, independent visibility benchmarks across
          ChatGPT, Perplexity, Gemini, and AI Overviews. We don't sell agency
          optimization—we give you the exact KPIs showing how AI models cite and
          rank your brand against competitors.
        </p>
        <a href="#request" class="btn-primary">Request a Sample Brand Report</a>
      </div>

      <!-- Sample Metrics -->
      <section id="metrics">
        <h2>What's inside a GeoMetrics report</h2>
        <p class="section-sub">
          A clear snapshot of your brand's current AI footprint—built for
          marketing and growth teams who want ground-truth numbers first.
        </p>

        <div class="grid-3">
          <div class="card">
            <div class="kpi-label">AI Citation Share (Sample)</div>
            <div class="kpi-value">34.2%</div>
            <p>
              How frequently your brand is mentioned or cited across high-intent
              category prompts compared to your top competitors.
            </p>
          </div>

          <div class="card">
            <div class="kpi-label">Answer Positioning (Sample)</div>
            <div class="kpi-value">#2 Avg</div>
            <p>
              Where your brand appears in AI-generated recommendations and how
              models describe your strengths and pricing.
            </p>
          </div>

          <div class="card">
            <div class="kpi-label">Citation Sources (Sample)</div>
            <div class="kpi-value">18 Domains</div>
            <p>
              The exact third-party articles, review sites, and pages that LLMs
              rely on when answering questions about your category.
            </p>
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section>
        <h2>How it works</h2>
        <p class="section-sub">
          No complex onboarding or software setup required.
        </p>

        <div class="grid-3">
          <div class="card">
            <div class="step-num">01 / REQUEST</div>
            <h3>Share your brand</h3>
            <p>
              Submit your website URL and email below. Tell us which brand you
              want benchmarked.
            </p>
          </div>

          <div class="card">
            <div class="step-num">02 / BENCHMARK</div>
            <h3>Receive a custom sample</h3>
            <p>
              We run a targeted GEO/AEO audit and email you a tailored snapshot
              of where you stand today.
            </p>
          </div>

          <div class="card">
            <div class="step-num">03 / TRACK</div>
            <h3>Optional monthly tracking</h3>
            <p>
              If the data is useful, keep a recurring monthly view to monitor
              shifts in AI visibility over time.
            </p>
          </div>
        </div>
      </section>

      <!-- Sample Report Request Form -->
      <section id="request">
        <h2>Request your sample report</h2>
        <p class="section-sub">
          Leave your details below. We'll prepare a custom sample snapshot for
          your brand and send it directly to your inbox—zero spam.
        </p>

        <div class="form-box">
          <!-- Replace YOUR_FORM_ID with your free Formspree ID -->
          <form action="https://formspree.io/f/xyewbbne" method="POST">
            <div class="form-group">
              <label for="brand">Brand Name or Website URL</label>
              <input
                type="text"
                id="brand"
                name="brand"
                placeholder="e.g. yourbrand.com"
                required
              />
            </div>

            <div class="form-group">
              <label for="email">Work Email</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="you@company.com"
                required
              />
            </div>

            <div class="form-group">
              <label for="phone">Phone / WhatsApp (Optional)</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+91 ..."
              />
            </div>

            <button type="submit" class="btn-primary">
              Send Me a Sample Report
            </button>
            <p class="form-note">
              No payment required. We'll reach out personally with your sample
              benchmark.
            </p>
          </form>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <div>© 2026 GeoMetrics. All rights reserved.</div>
        <div class="footer-links">
          <a href="/blog">Blog</a>
          <a href="#request">Request Sample</a>
        </div>
      </div>
    </footer>
  </body>
</html>